<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ReportsActivity"
    android:background="@color/white">

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:paddingLeft="12dp"
        android:paddingRight="12dp"
        android:id="@+id/bottom_navigator"
        android:background="@color/white"
        app:labelVisibilityMode="labeled"
        app:itemTextColor="@drawable/selector"
        app:itemIconTint="@drawable/selector"
        app:menu="@menu/bottom_navi"
        android:layout_alignParentBottom="true"
        />

    <ImageView
        android:id="@+id/TopLLg"
        android:layout_width="100dp"
        android:layout_height="59dp"
        android:layout_alignParentStart="true"
        android:layout_alignParentTop="true"
        android:layout_centerHorizontal="true"
        android:layout_marginStart="10dp"
        android:layout_marginTop="10dp"
        app:srcCompat="@drawable/flexpaltlogo" />

    <TextView
        android:id="@+id/textView7"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentStart="true"
        android:layout_alignParentTop="true"
        android:layout_marginStart="10dp"
        android:layout_marginTop="76dp"
        android:fontFamily="@font/roboto"
        android:text="REPORTS"
        android:textColor="@color/black"
        android:textSize="16dp"
        android:textStyle="bold" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_alignParentStart="true"
        android:layout_alignParentEnd="true"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:layout_marginStart="5dp"
        android:layout_marginTop="100dp"
        android:layout_marginEnd="5dp"
        android:layout_marginBottom="58dp"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <androidx.cardview.widget.CardView
                android:id="@+id/Rtips"
                android:layout_width="match_parent"
                android:layout_height="70dp"
                android:backgroundTint="@color/gray"
                app:cardCornerRadius="15dp">

                <ImageView
                    android:id="@+id/imageView"
                    android:layout_width="40dp"
                    android:layout_height="30dp"
                    android:layout_marginStart="20dp"
                    android:layout_marginTop="20dp"
                    android:src="@drawable/baseline_tips_and_updates_24" />

                <TextView
                    android:id="@+id/Rtipstxt"
                    android:layout_width="295dp"
                    android:layout_height="60dp"
                    android:layout_marginStart="60dp"
                    android:layout_marginTop="5dp"
                    android:gravity="center"
                    android:text="Drink water before, during, and after your workout to stay properly hydrated."
                    android:textColor="@color/black"
                    android:textSize="11dp"
                    android:textStyle="bold" />

            </androidx.cardview.widget.CardView>

            <TextView
                android:id="@+id/textView0"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:fontFamily="@font/roboto"
                android:text="HISTORY"
                android:textColor="@color/black"
                android:textSize="16dp"
                android:textStyle="bold" />

            <androidx.cardview.widget.CardView
                android:id="@+id/Rhistorybts"
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:backgroundTint="@color/gray"
                app:cardCornerRadius="15dp">

                <ImageView
                    android:id="@+id/imageView1"
                    android:layout_width="60dp"
                    android:layout_height="20dp"
                    android:layout_marginStart="45dp"
                    android:layout_marginTop="15dp"
                    android:src="@drawable/rbest_xaml" />

                <TextView
                    android:id="@+id/fillworkouts"
                    android:layout_width="60dp"
                    android:layout_height="20dp"
                    android:layout_marginStart="45dp"
                    android:layout_marginTop="45dp"
                    android:gravity="center"
                    android:text="0"
                    android:textColor="@color/black"
                    android:textSize="16dp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/textView52"
                    android:layout_width="68dp"
                    android:layout_height="30dp"
                    android:layout_marginStart="40dp"
                    android:layout_marginTop="65dp"
                    android:gravity="center"
                    android:text="Workouts"
                    android:textColor="@color/black"
                    android:textSize="12dp"
                    android:textStyle="bold" />

                <ImageView
                    android:id="@+id/imageView4"
                    android:layout_width="60dp"
                    android:layout_height="20dp"
                    android:layout_marginStart="160dp"
                    android:layout_marginTop="15dp"
                    android:src="@drawable/rcal_xaml" />

                <TextView
                    android:id="@+id/fillcals"
                    android:layout_width="60dp"
                    android:layout_height="20dp"
                    android:layout_marginStart="160dp"
                    android:layout_marginTop="45dp"
                    android:gravity="center"
                    android:text="0"
                    android:textColor="@color/black"
                    android:textSize="16dp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/textView53"
                    android:layout_width="60dp"
                    android:layout_height="30dp"
                    android:layout_marginStart="160dp"
                    android:layout_marginTop="65dp"
                    android:gravity="center"
                    android:text="Kcal"
                    android:textColor="@color/black"
                    android:textSize="12dp"
                    android:textStyle="bold" />

                <ImageView
                    android:id="@+id/imageView6"
                    android:layout_width="60dp"
                    android:layout_height="20dp"
                    android:layout_marginStart="270dp"
                    android:layout_marginTop="15dp"
                    android:src="@drawable/rtime_xaml" />

                <TextView
                    android:id="@+id/filltimes"
                    android:layout_width="60dp"
                    android:layout_height="20dp"
                    android:layout_marginStart="270dp"
                    android:layout_marginTop="45dp"
                    android:gravity="center"
                    android:text="0"
                    android:textColor="@color/black"
                    android:textSize="16dp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/textView534"
                    android:layout_width="60dp"
                    android:layout_height="30dp"
                    android:layout_marginStart="270dp"
                    android:layout_marginTop="65dp"
                    android:gravity="center"
                    android:text="Minutes"
                    android:textColor="@color/black"
                    android:textSize="12dp"
                    android:textStyle="bold" />

            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:id="@+id/Rhistorygrph"
                android:layout_width="match_parent"
                android:layout_height="195dp"
                android:layout_marginTop="10dp"
                android:backgroundTint="@color/gray"
                app:cardCornerRadius="15dp" >

                <ProgressBar
                    android:id="@+id/pbarworkouts"
                    android:theme="@style/progressbar"
                    android:layout_width="124dp"
                    android:layout_height="117dp"
                    android:layout_centerVertical="true"
                    android:layout_marginTop="30dp"
                    android:indeterminate="false"
                    android:progressDrawable="@drawable/progressbarbg"
                    android:background="@drawable/progressbarshape"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:max="100"
                    android:progress="65"
                    android:rotation="180"/>

                <TextView
                    android:id="@+id/pbwkpercntage"
                    android:layout_width="50dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="40dp"
                    android:layout_marginTop="80dp"
                    android:text="100%"
                    android:gravity="center"
                    android:textColor="@color/black"
                    android:textStyle="bold"
                    android:textSize="13dp"/>

                <TextView
                    android:id="@+id/pbwkprogress"
                    android:layout_width="70dp"
                    android:gravity="center"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="25dp"
                    android:layout_marginTop="145dp"
                    android:text="100/100"
                    android:textColor="@color/black"
                    android:textStyle="bold"
                    android:textSize="13dp" />

                <ProgressBar
                    android:id="@+id/pbbarcalories"
                    android:theme="@style/progressbar"
                    android:layout_width="124dp"
                    android:layout_height="117dp"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="130dp"
                    android:layout_marginTop="20dp"
                    android:progressDrawable="@drawable/progressbarbg"
                    android:background="@drawable/progressbarshape"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:max="100"
                    android:progress="65"
                    android:rotation="180"/>

                <TextView
                    android:id="@+id/pbcalpercntage"
                    android:layout_width="50dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="170dp"
                    android:layout_marginTop="70dp"
                    android:text="100%"
                    android:gravity="center"
                    android:textColor="@color/black"
                    android:textStyle="bold"
                    android:textSize="13dp"/>

                <TextView
                    android:id="@+id/pbcalprogress"
                    android:layout_width="70dp"
                    android:gravity="center"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="155dp"
                    android:layout_marginTop="135dp"
                    android:text="100/100"
                    android:textColor="@color/black"
                    android:textStyle="bold"
                    android:textSize="13dp" />

                <ProgressBar
                    android:id="@+id/pbminutes"
                    android:theme="@style/progressbar"
                    android:layout_width="124dp"
                    android:layout_height="117dp"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="260dp"
                    android:layout_marginTop="30dp"
                    android:progressDrawable="@drawable/progressbarbg"
                    android:background="@drawable/progressbarshape"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:max="100"
                    android:progress="65"
                    android:rotation="180"/>

                <TextView
                    android:id="@+id/pbmpercntage"
                    android:layout_width="50dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="300dp"
                    android:layout_marginTop="80dp"
                    android:gravity="center"
                    android:text="100%"
                    android:textColor="@color/black"
                    android:textStyle="bold"
                    android:textSize="13dp"/>

                <TextView
                    android:id="@+id/pbmprogress"
                    android:layout_width="70dp"
                    android:gravity="center"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="285dp"
                    android:layout_marginTop="145dp"
                    android:text="100/100"
                    android:textColor="@color/black"
                    android:textStyle="bold"
                    android:textSize="13dp" />

            </androidx.cardview.widget.CardView>

            <TextView
                android:id="@+id/textView02"
                android:layout_marginTop="15dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/roboto"
                android:text="BMI"
                android:textColor="@color/black"
                android:textSize="16dp"
                android:textStyle="bold" />

            <androidx.cardview.widget.CardView
                android:id="@+id/Rbmi"
                android:layout_width="match_parent"
                android:layout_height="210dp"
                android:backgroundTint="@color/gray"
                app:cardCornerRadius="15dp">

                <androidx.cardview.widget.CardView
                    android:id="@+id/Rbmi15"
                    android:layout_width="25dp"
                    android:layout_height="30dp"
                    android:layout_marginStart="20dp"
                    android:layout_marginTop="80dp"
                    app:cardCornerRadius="5dp" />

                <androidx.cardview.widget.CardView
                    android:id="@+id/Rbmi16"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_marginStart="48dp"
                    android:layout_marginTop="80dp"
                    app:cardCornerRadius="5dp" />

                <androidx.cardview.widget.CardView
                    android:id="@+id/Rbmi18"
                    android:layout_width="80dp"
                    android:layout_height="30dp"
                    android:layout_marginStart="81dp"
                    android:layout_marginTop="80dp"
                    app:cardCornerRadius="5dp" />

                <androidx.cardview.widget.CardView
                    android:id="@+id/Rbmi25"
                    android:layout_width="45dp"
                    android:layout_height="30dp"
                    android:layout_marginStart="165dp"
                    android:layout_marginTop="80dp"
                    app:cardCornerRadius="5dp" />

                <androidx.cardview.widget.CardView
                    android:id="@+id/Rbmi30"
                    android:layout_width="45dp"
                    android:layout_height="30dp"
                    android:layout_marginStart="213dp"
                    android:layout_marginTop="80dp"
                    app:cardCornerRadius="5dp" />

                <androidx.cardview.widget.CardView
                    android:id="@+id/Rbmi35"
                    android:layout_width="45dp"
                    android:layout_height="30dp"
                    android:layout_marginStart="261dp"
                    android:layout_marginTop="80dp"
                    app:cardCornerRadius="5dp" />

                <androidx.cardview.widget.CardView
                    android:id="@+id/Rbmi40"
                    android:layout_width="45dp"
                    android:layout_height="30dp"
                    android:layout_marginStart="309dp"
                    android:layout_marginTop="80dp"
                    app:cardCornerRadius="5dp" />

                <View
                    android:layout_width="331dp"
                    android:layout_height="2dp"
                    android:layout_marginStart="22dp"
                    android:layout_marginTop="135dp"
                    android:background="@color/black" />

                <TextView
                    android:id="@+id/Rbmiresult"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="30dp"
                    android:layout_marginTop="25dp"
                    android:drawableLeft="@drawable/rbmicon_xaml"
                    android:gravity="center"
                    android:text="00.00"
                    android:textColor="@color/black"
                    android:textSize="14dp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/Rbmiresulttxt"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="220dp"
                    android:layout_marginTop="25dp"
                    android:drawableLeft="@drawable/rcategcon_xaml"
                    android:gravity="center"
                    android:text="BMI Category"
                    android:textColor="@color/black"
                    android:textSize="14dp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/textView60"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_marginTop="110dp"
                    android:text="15"
                    android:textColor="@color/black" />

                <TextView
                    android:id="@+id/textView65"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="41dp"
                    android:layout_marginTop="110dp"
                    android:text="16"
                    android:textColor="@color/black" />

                <TextView
                    android:id="@+id/textView64"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="71dp"
                    android:layout_marginTop="110dp"
                    android:text="18.5"
                    android:textColor="@color/black" />

                <TextView
                    android:id="@+id/textView63"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="159dp"
                    android:layout_marginTop="110dp"
                    android:text="25"
                    android:textColor="@color/black" />

                <TextView
                    android:id="@+id/textView62"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="208dp"
                    android:layout_marginTop="110dp"
                    android:text="30"
                    android:textColor="@color/black" />

                <TextView
                    android:id="@+id/textView61"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="257dp"
                    android:layout_marginTop="110dp"
                    android:text="35"
                    android:textColor="@color/black" />

                <TextView
                    android:id="@+id/textView612"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="304dp"
                    android:layout_marginTop="110dp"
                    android:text="40"
                    android:textColor="@color/black" />

                <EditText
                    android:id="@+id/Rbmiheight"
                    android:layout_width="89dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="40dp"
                    android:layout_marginTop="145dp"
                    android:drawableLeft="@drawable/rheightcon_xaml"
                    android:ems="10"
                    android:hint="Height"
                    android:inputType="numberDecimal"
                    android:textColor="@color/black"
                    android:textSize="12dp" />

                <Spinner
                    android:id="@+id/Rbmifhg"
                    android:layout_width="85dp"
                    android:layout_height="30dp"
                    android:layout_marginStart="120dp"
                    android:layout_marginTop="150dp"
                    android:entries="@array/height_units"
                    android:gravity="center" />

                <EditText
                    android:id="@+id/Rbmiweight"
                    android:layout_width="89dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="200dp"
                    android:layout_marginTop="145dp"
                    android:drawableLeft="@drawable/rweightcon_xaml"
                    android:ems="10"
                    android:hint="Weight"
                    android:inputType="numberDecimal"
                    android:textColor="@color/black"
                    android:textSize="12dp" />

                <Spinner
                    android:id="@+id/Rbmifwg"
                    android:layout_width="80dp"
                    android:layout_height="30dp"
                    android:layout_marginStart="280dp"
                    android:layout_marginTop="150dp"
                    android:entries="@array/height_units"
                    android:gravity="center" />
            </androidx.cardview.widget.CardView>
        </LinearLayout>
    </ScrollView>

</RelativeLayout>