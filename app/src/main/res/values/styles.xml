<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="DatePickerTheme" parent="Theme.AppCompat.Light.Dialog">
        <item name="colorAccent">@color/black</item>
    </style>
    <style name="progressbar" parent="ThemeOverlay.AppCompat.Light">
        <item name="colorAccent">@color/black</item>
    </style>

    <style name="AlertDialogTheme" parent="Theme.AppCompat.Dialog.Alert">
        <item name="android:background">@color/gray</item>
        <!-- Set corner radius for rounded corners -->
        <item name="android:windowBackground">@drawable/dialogbg</item>
        <!-- Customize the text color -->
        <item name="android:textColorPrimary">@color/black</item>
        <!-- Customize the text color for the message -->
        <item name="android:textColorSecondary">@color/black</item>
        <item name="android:textColor">@color/black</item>
    </style>

    <style name="circleImageView" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>
</resources>